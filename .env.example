# Local-only test configuration. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and is read ONLY by the test suite (vitest.config.ts).
# The application never reads these values: the shipped editor takes AES keys
# from the user at open time and loads G.719 modules from IndexedDB, so the
# production build contains no key material and no codec binaries. Nothing here
# is ever bundled.
#
# Everything below is optional. Leave a value unset and the suites that need it
# skip with an explanation; the rest of the tests still run and must pass.

# --- AES-256 keys -------------------------------------------------------------
# 64 hex characters (32 bytes) each. Used to decrypt the fumen and datatable
# fixtures. If unset, the suite falls back to reading them from the
# TaikoArcadeLoader source under BACHI_RESOURCES_DIR.
# A malformed value fails loudly rather than skipping, so typos surface.
#BACHI_DATATABLE_KEY=
#BACHI_FUMEN_KEY=

# --- Corpus location ----------------------------------------------------------
# Root of the separately held game/server corpus. Absolute, or relative to the
# repository root. Defaults to `../resources` (a sibling checkout).
# Expected layout:
#   <root>/TaikoCHN/Data/x64/{fumen,sound,datatable}
#   <root>/JPN39.06/Data/x64/{fumen,sound,datatable}
#   <root>/TaikoLocalServer-dev/Host/wwwroot/data
#   <root>/ese/                       (TJA import corpus)
#   <root>/TaikoArcadeLoader-Refactor/src/patches/layeredfs.cpp
#BACHI_RESOURCES_DIR=../resources

# --- G.719 codec modules ------------------------------------------------------
# Directory holding `g719.wasm` and `g719-encoder.wasm`. Defaults to the
# gitignored `vendor/g719/` in this repo, falling back to
# `$BACHI_RESOURCES_DIR/g719`. These are proprietary build artifacts: keep them
# out of version control.
#BACHI_G719_DIR=vendor/g719
